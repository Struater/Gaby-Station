<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    VerticalExpand="False" HorizontalExpand="False"
    Title="{Loc sc-gambleui-title}"
    SetSize="430 580" >
    <BoxContainer Orientation="Vertical">
        <!-- Footer will always appear -->
        <BoxContainer Orientation="Vertical" HorizontalAlignment="Center" Name="Header">
            <Label Text="Fortune Clown Logo Placeholder" Name="Logo" />
            <controls:HSpacer Spacing="15" />
        </BoxContainer>

        <!-- Lobby, where you deposit the coins -->
        <BoxContainer VerticalExpand="True" Visible="True" Orientation="Vertical" Name="Lobby">
            <controls:StripeBack>
                <Label Text="Gambling Lobby:" StyleClasses="LabelHeading"/>
            </controls:StripeBack>

            <PanelContainer VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1b1b1e" />
                </PanelContainer.PanelOverride>
                <BoxContainer VerticalExpand="True" Visible="True" Orientation="Vertical" Margin="8">

                <controls:HSpacer Spacing="5" />

                <BoxContainer>
                    <Label Text="Deposit play money: " />
                    <LineEdit Name="LobbyMoneyDeposit" PlaceHolder="0" HorizontalExpand="True" MinWidth="80" />
                </BoxContainer>
                <BoxContainer>
                    <Label Text="Select game mode: " />
                    <OptionButton Name="LobbyGameMode" Access="Public" HorizontalExpand="True" StyleClasses="OpenRight"/>
                </BoxContainer>
                <BoxContainer>
                    <Label Text="Select option: " />
                    <OptionButton Name="LobbyGameOption" Access="Public" HorizontalExpand="True" StyleClasses="OpenRight"/>
                </BoxContainer>

                <!-- Only to put the lobby footer in the bottom -->
                <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="true" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextureRect Name="SelectedGameTexture" Stretch="KeepCentered" SetSize="210 210" />
                    </BoxContainer>
                    <RichTextLabel Text="[color=gray]Double: 3 colors, an random color will be selected." Name="SelectedGameInfo"/>
                </BoxContainer>

                <BoxContainer Orientation="Vertical" HorizontalExpand="True" HorizontalAlignment="Center">
                        <Button Name="LobbyPlayButton" Text="GAMBLE!!!" StyleClasses="ButtonBig" />
                        <RichTextLabel Text="[color=gray]![bold][color=white]Pro Tip[/color][/bold]: [bold]99%[/bold] of gamblers quit before they [bold][color=green]hit big[/color][/bold]!"/>
                </BoxContainer>

                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

        <!-- Game, where you gamble!!! -->
        <BoxContainer Visible="False" Orientation="Vertical" Name="Game">
            <PanelContainer VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1b1b1e" />
                </PanelContainer.PanelOverride>
                    <BoxContainer VerticalExpand="True" Name="GameContainer">
                        <!-- Add here double 3 button to animation -->
                    </BoxContainer>
                <BoxContainer VerticalExpand="True" Visible="True" Orientation="Vertical" Margin="8">

                </BoxContainer>
            </PanelContainer>

            <BoxContainer Name="Result" Visible="False" HorizontalAlignment="Center">
                <Button Name="ResultRestartButton" Text="Restart" StyleClasses="ButtonBig" />
                <RichTextLabel Text="" Name="ResultLabel"/>
            </BoxContainer>
        </BoxContainer>

        <!-- Footer -->
        <BoxContainer HorizontalExpand="True" Orientation="Vertical" Name="Footer">
            <controls:HSpacer Spacing="10"/>
            <controls:StripeBack>
                <Label Text="Current currency: 999GC" HorizontalExpand="True" Name="FooterCurrency" />
            </controls:StripeBack>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
